PORT=8080
DATABASE_PATH=/data/changeslip.db
SECRET_KEY=change-me

# Set this on any VPS reachable from the internet. Empty = open admin (local/dev only).
OWNER_PASSWORD=

BUSINESS_NAME=
PUBLIC_BASE_URL=http://localhost:8080

# Display default for new slips (overridable per slip).
CURRENCY=USD

# Extra Accept friction: customer must type customer_name (case-insensitive trim). Default false.
REQUIRE_TYPED_NAME=false

FROM_NAME=
FROM_EMAIL=

# Accept/decline alerts when SMTP is set. Leave empty to rely on the in-app UI.
OWNER_NOTIFY_EMAIL=

# Optional SMTP. Leave SMTP_HOST unset to copy link / blurbs without sending.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_TLS=true

# Optional footer link labeled "Powered by ChangeSlip". Leave empty for no footer.
MARKETING_URL=
